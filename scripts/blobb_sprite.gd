class_name BlobbSprite
extends AnimatedSprite2D
## Blobb's animated sprite (front view) built from the keyed strips in assets/sprites/.
## Strips are generated by tools/key_frames.py. Carries the recolour shader (see set_tint()).

const FRAME_W := 321
const FRAME_H := 305
## Blobb's "official" colour since the narrators settled it in ch1 ("He's green!").
const GREEN := Color(0.62, 0.85, 0.32)
const GOLD := Color(1.0, 0.8, 0.25)  # the wrong colour: O's in ch1, the lamplight's in ch3
const GREEN_AMOUNT := 0.5
## Cold-water Blobb (ch2). The drawn blue figure is pale, so the tint does most of the work.
const BLUE := Color(0.42, 0.66, 1.0)
const BLUE_AMOUNT := 0.7
const STRIPS := {
	"idle": ["res://assets/sprites/blobb_idle.png", 24.0, true],
	"run": ["res://assets/sprites/blobb_running.png", 40.0, true],
	"jump": ["res://assets/sprites/blobb_jumping.png", 18.0, false],
	# the big story-unlocked jump: he crouches, then stretches into a long tilted oval
	# (tools/key_superjump.py; like the little flying Blobb in the original drawing)
	"superjump": ["res://assets/sprites/blobb_superjump.png", 20.0, false],
	# animated forms (tools/key_form.py): when one exists, set_form() plays it instead of the drawing
	# (a 4th entry true: played forward then back, so a clip that doesn't loop cleanly has no seam)
	"grumpy": ["res://assets/sprites/blobb_grumpy.png", 24.0, true, true],
	"calm": ["res://assets/sprites/blobb_calm.png", 24.0, false],  # spiky back to ordinary (_calm_down)
	"dash": ["res://assets/sprites/blobb_dash.png", 32.0, true, true],
	# ch5's start: still straining from the climb, eyes squeezed shut (stretch and sag; loops)
	"climb": ["res://assets/sprites/blobb_climb.png", 16.0, true],
}
## Forms taken straight from the child's drawing (tools/cut_drawing.py). While a form is
## shown, the animated strips are hidden and the drawn figure breathes gently instead
## (or, if STRIPS has an animation with the form's name, that plays instead of the drawing).
const FORMS := {
	"grumpy": "res://assets/sprites/drawn_grumpy.png",   # spiky dark crown, angry brows, jagged teeth
	"blue": "res://assets/sprites/drawn_blue.png",       # blue, open-mouthed (ch2: pair with set_tint(BLUE))
	"dash": "res://assets/sprites/drawn_dash.png",       # green blur + speed lines (planned: ch3 rooftop chase)
	"ball": "res://assets/sprites/drawn_ball.png",       # round scribble, no face (curled up / seen from above)
	"drawn": "res://assets/sprites/drawn_blobb.png",     # the original classic Blobb, still
}
## Which way the art faces. Most of it faces LEFT (the strips and the classic, grumpy and blue
## drawings); only these face right. Always turn Blobb with face(), never flip_h directly.
const FACES_RIGHT := {"superjump": true, "dash": true}
## Height of a drawn form in this sprite's local pixels (the strips' Blobb is ~280 tall).
const FORM_HEIGHT := 270.0
## How far below a strip frame's centre his feet are (305 tall, feet ~20 px above the bottom).
const FEET_BELOW_CENTRE := 132.0

var form := "normal"
var facing_left := false
var _mat: ShaderMaterial
var _tint_tween: Tween
var _drawn: Sprite2D
var _anim: AnimatedSprite2D  # an animated form (a strip in STRIPS with the form's name)
var _bristles := 0  # counts bristle() calls, so only the latest one turns him back
var _outro: Tween  # an animated form fading back into the normal Blobb (set_form("normal"))
var _t := 0.0


func _init() -> void:
	sprite_frames = build_frames()
	_mat = green_material()
	material = _mat
	play("idle")


## Blobb's recolour shader at his canonical green, for other sprites that show him.
static func green_material() -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = preload("res://shaders/blobb.gdshader")
	m.set_shader_parameter("tint", GREEN)
	m.set_shader_parameter("tint_amount", GREEN_AMOUNT)
	return m


static func build_frames() -> SpriteFrames:
	var sf := SpriteFrames.new()
	sf.remove_animation("default")
	for anim in STRIPS:
		var info: Array = STRIPS[anim]
		if not ResourceLoader.exists(info[0]):
			continue
		var tex: Texture2D = load(info[0])
		# a strip of frames, or (the long ones, tools/grid_strip.py) a grid read row by row
		var cols := int(round(float(tex.get_width()) / FRAME_W))
		var frame_h := float(FRAME_H)
		var count := cols * int(round(tex.get_height() / frame_h))
		sf.add_animation(anim)
		sf.set_animation_speed(anim, info[1])
		sf.set_animation_loop(anim, info[2])
		var order := range(count)
		if info.size() > 3 and info[3]:
			order += range(count - 2, 0, -1)
		for i in order:
			var at := AtlasTexture.new()
			at.atlas = tex
			at.region = Rect2((i % cols) * FRAME_W, (i / cols) * frame_h, FRAME_W, frame_h)
			sf.add_frame(anim, at)
	return sf


## Show one of the drawn FORMS ("normal" = back to the animated Blobb), with a little pop.
func set_form(new_form: String) -> void:
	if new_form == form:
		return
	if new_form != "normal" and not (FORMS.has(new_form) and ResourceLoader.exists(FORMS[new_form])):
		push_warning("BlobbSprite.set_form: no form " + new_form)
		return
	var old := form
	form = new_form
	if _outro and _outro.is_valid():
		_outro.kill()
		_reset_anim()
	if new_form == "grumpy" and is_inside_tree():
		Game.sfx("bristle", -5.0, randf_range(0.95, 1.08))  # the spikes shoot out
	if new_form == "normal" and old == "grumpy" and _anim and _anim.visible:
		_calm_down()
		return
	if _drawn:
		_drawn.visible = false
	if _anim:
		_anim.visible = false
	if new_form == "normal":
		self_modulate.a = 1.0
	elif sprite_frames.has_animation(new_form):
		if not _anim:
			_anim = AnimatedSprite2D.new()
			_anim.sprite_frames = sprite_frames
			_anim.use_parent_material = true
			add_child(_anim)
		_anim.visible = true
		_anim.play(new_form)
		_t = 0.0
		self_modulate.a = 0.0
		var tw := create_tween()
		_anim.scale = Vector2(1.3, 0.7)
		tw.tween_property(_anim, "scale", Vector2.ONE, 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	else:
		if not _drawn:
			_drawn = Sprite2D.new()
			add_child(_drawn)
		_drawn.texture = load(FORMS[new_form])
		# forms go through the same recolour shader as the animated Blobb (set_tint), so they match him
		_drawn.use_parent_material = true
		_drawn.visible = true
		var k := FORM_HEIGHT / _drawn.texture.get_height()
		_drawn.set_meta("k", k)
		_drawn.offset = Vector2(0, -_drawn.texture.get_height() * 0.5)
		_drawn.position = Vector2(0, 150)  # feet on the same line as the strips' feet
		self_modulate.a = 0.0
		_t = 0.0
		var tw := create_tween()
		_drawn.scale = Vector2(k * 1.3, k * 0.7)
		tw.tween_property(_drawn, "scale", Vector2(k, k), 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


## Back from the spiky form: the spikes sink in (the prickly Blobb squashes down and fades) while the
## normal Blobb fills out in his place, with a little shake as he settles, and a soft "pfff".
func _calm_down() -> void:
	if is_inside_tree():
		Game.sfx("unbristle", -6.0, randf_range(0.95, 1.05))
	_anim.position = Vector2.ZERO
	_anim.rotation = 0.0
	self_modulate.a = 0.0
	if sprite_frames.has_animation("calm"):  # the drawn way back: spikes sink in, the face calms
		_anim.play("calm")
		_outro = create_tween()
		_outro.tween_interval(sprite_frames.get_frame_count("calm") / sprite_frames.get_animation_speed("calm"))
		_outro.tween_callback(_reset_anim)
		return
	var turn := -1.0 if facing_left else 1.0
	_outro = create_tween().set_parallel()
	_outro.tween_property(_anim, "scale", Vector2(1.12, 0.78), 0.35).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
	_outro.tween_property(_anim, "position", Vector2(0, 30), 0.35).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
	_outro.tween_property(_anim, "modulate:a", 0.0, 0.35)
	_outro.tween_property(self, "self_modulate:a", 1.0, 0.3).set_delay(0.08)
	_outro.tween_property(self, "rotation", 0.07 * turn, 0.09).set_delay(0.3)
	_outro.chain().tween_property(self, "rotation", -0.05 * turn, 0.1)
	_outro.chain().tween_property(self, "rotation", 0.0, 0.12)
	_outro.chain().tween_callback(_reset_anim)


func _reset_anim() -> void:
	rotation = 0.0
	if _anim:
		if form == "normal":
			_anim.visible = false
		_anim.modulate.a = 1.0
		_anim.scale = Vector2.ONE
		_anim.position = Vector2.ZERO
	if form == "normal":
		self_modulate.a = 1.0


## A knock makes him prickly for a moment (the grumpy form), then he's himself again. Spikes are
## his stubbornness, never a weapon: whatever knocked him (a fish, the banana) is not hurt.
func bristle(secs := 1.2) -> void:
	if form != "normal" and form != "grumpy":
		return  # a story form (blue, dash, ...) stays as the story set it
	_bristles += 1
	var mine := _bristles
	set_form("grumpy")
	await get_tree().create_timer(secs).timeout
	if mine == _bristles and form == "grumpy":
		set_form("normal")


## Turn Blobb toward dir (< 0 left, > 0 right; 0 keeps his facing).
func face(dir: float) -> void:
	if dir != 0.0:
		facing_left = dir < 0.0
	_apply_facing()


func _apply_facing() -> void:
	# mirror the art only when it faces the other way from where he's heading
	flip_h = facing_left == FACES_RIGHT.has(animation)
	if _drawn:
		_drawn.flip_h = facing_left == FACES_RIGHT.has(form)
	if _anim:
		_anim.flip_h = facing_left == FACES_RIGHT.has(form)


func _process(delta: float) -> void:
	_apply_facing()  # the animation can change under us (run -> superjump)
	if _drawn and _drawn.visible:
		_t += delta
		var k: float = _drawn.get_meta("k")
		if _t > 0.4:  # after the pop: breathe
			_drawn.scale = Vector2(k, k * (1.0 + sin(_t * 3.0) * 0.025))
	elif _anim and _anim.visible and not (_outro and _outro.is_running()):
		_t += delta
		if _t > 0.4:  # after the pop
			_live(_anim)


## Keeps an animated form alive the way the idle and run strips are: it breathes standing
## still, and bobs and leans in step while he moves (the form clips themselves barely move).
func _live(n: Node2D) -> void:
	var moving := animation != "idle"  # the hidden strip still follows what the player does
	var lean := -1.0 if facing_left else 1.0
	if form == "dash":  # always on the go: a quick, low bob and a forward lean
		var b := absf(sin(_t * 16.0))
		n.position = Vector2(0, -b * 7.0)
		n.rotation = lean * (0.06 + sin(_t * 16.0) * 0.025)
		n.scale = Vector2(1.0 + b * 0.04, 1.0 - b * 0.04)
	elif moving:  # a hop each step, squashed as he lands
		var b := absf(sin(_t * 11.0))
		n.position = Vector2(0, -b * 12.0)
		n.rotation = lean * sin(_t * 11.0) * 0.05
		n.scale = Vector2(1.0 + (1.0 - b) * 0.06, 1.0 - (1.0 - b) * 0.06)
	else:  # breathing, a little deeper than the drawn forms (it's the whole body)
		var br := sin(_t * 3.2)
		n.position = Vector2(0, -br * 2.0)
		n.rotation = sin(_t * 1.3) * 0.015
		n.scale = Vector2(1.0 - br * 0.02, 1.0 + br * 0.035)
	n.position.y += (1.0 - n.scale.y) * FEET_BELOW_CENTRE  # squash from the feet, not the middle


## Recolour Blobb. amount 0 = his natural crayon colours.
func set_tint(color: Color, amount: float, dur := 0.8) -> void:
	if _tint_tween:
		_tint_tween.kill()
	_mat.set_shader_parameter("tint", color)
	var from: float = _p("tint_amount")
	_tint_tween = create_tween()
	_tint_tween.tween_method(func(v): _mat.set_shader_parameter("tint_amount", v), from, amount, dur)


func set_glow(amount: float, color := Color(1.0, 0.9, 0.3), dur := 1.0) -> void:
	_mat.set_shader_parameter("glow_color", color)
	var tw := create_tween()
	tw.tween_method(func(v): _mat.set_shader_parameter("glow", v), _p("glow"), amount, dur)


func flash(dur := 0.4) -> void:
	var tw := create_tween()
	tw.tween_method(func(v): _mat.set_shader_parameter("flash", v), 1.0, 0.0, dur)


func _p(n: StringName) -> float:
	var v = _mat.get_shader_parameter(n)
	return 0.0 if v == null else v
