class_name BlobbSprite
extends AnimatedSprite2D
## Blobb's animated sprite (front view) built from the keyed strips in assets/sprites/.
## Strips are generated by tools/key_frames.py. Carries the recolour shader (see set_tint()).

const FRAME_W := 321
## Blobb's "official" colour since the narrators settled it in ch1 ("He's green!").
const GREEN := Color(0.62, 0.85, 0.32)
const GREEN_AMOUNT := 0.5
const STRIPS := {
	"idle": ["res://assets/sprites/blobb_idle.png", 24.0, true],
	"run": ["res://assets/sprites/blobb_running.png", 40.0, true],
	"jump": ["res://assets/sprites/blobb_jumping.png", 18.0, false],
}

var _mat: ShaderMaterial
var _tint_tween: Tween


func _init() -> void:
	sprite_frames = build_frames()
	_mat = ShaderMaterial.new()
	_mat.shader = preload("res://shaders/blobb.gdshader")
	material = _mat
	_mat.set_shader_parameter("tint", GREEN)
	_mat.set_shader_parameter("tint_amount", GREEN_AMOUNT)
	play("idle")


static func build_frames() -> SpriteFrames:
	var sf := SpriteFrames.new()
	sf.remove_animation("default")
	for anim in STRIPS:
		var info: Array = STRIPS[anim]
		var tex: Texture2D = load(info[0])
		var count := int(round(float(tex.get_width()) / FRAME_W))
		sf.add_animation(anim)
		sf.set_animation_speed(anim, info[1])
		sf.set_animation_loop(anim, info[2])
		for i in count:
			var at := AtlasTexture.new()
			at.atlas = tex
			at.region = Rect2(i * FRAME_W, 0, FRAME_W, tex.get_height())
			sf.add_frame(anim, at)
	return sf


## Recolour Blobb. amount 0 = his natural crayon colours.
func set_tint(color: Color, amount: float, dur := 0.8) -> void:
	if _tint_tween:
		_tint_tween.kill()
	_mat.set_shader_parameter("tint", color)
	var from: float = _p("tint_amount")
	_tint_tween = create_tween()
	_tint_tween.tween_method(func(v): _mat.set_shader_parameter("tint_amount", v), from, amount, dur)


func set_glow(amount: float, color := Color(1.0, 0.9, 0.3), dur := 1.0) -> void:
	_mat.set_shader_parameter("glow_color", color)
	var tw := create_tween()
	tw.tween_method(func(v): _mat.set_shader_parameter("glow", v), _p("glow"), amount, dur)


func flash(dur := 0.4) -> void:
	var tw := create_tween()
	tw.tween_method(func(v): _mat.set_shader_parameter("flash", v), 1.0, 0.0, dur)


func _p(n: StringName) -> float:
	var v = _mat.get_shader_parameter(n)
	return 0.0 if v == null else v
